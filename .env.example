# TermWise AI Configuration

# Whether to run in Mock Mode (true/false)
MOCK_LLM=true

# API credentials (required if MOCK_LLM=false)
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# Razorpay Integration (Optional - Demo Mode is default if missing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
MOCK_RAZORPAY=false

